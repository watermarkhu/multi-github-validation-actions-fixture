{
  "name": "multi-github-validation-workflows",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Reusable workflow + actions to cross-validate CI across multiple GitHub instances.",
  "license": "MIT",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm run build:report && pnpm run build:push",
    "build:report": "esbuild src/report/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=report/dist/index.cjs",
    "build:push": "esbuild src/push/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=push/dist/index.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package": "pnpm run build"
  },
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^6.0.0",
    "@octokit/auth-app": "^7.1.1",
    "@octokit/rest": "^20.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@typescript-eslint/eslint-plugin": "^7.5.0",
    "@typescript-eslint/parser": "^7.5.0",
    "esbuild": "^0.20.2",
    "eslint": "^8.57.0",
    "typescript": "^5.4.4",
    "vitest": "^1.4.0"
  }
}
